# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=pixelmart-super-secret-key-change-in-production

# MySQL Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pixelmart_db
# Fallback SQLite URI for quick local development/testing without MySQL running:
SQLITE_DATABASE_URL=sqlite:///pixelmart_dev.db

# File Upload Directories
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=33554432  # 32 MB maximum file upload size
